
<div class="dashboard">

    <%- include("components/$header") %>

    <div class="quickInfo">
        <div>
            <p>Total Time</p>
            <p><%= period.text %></p>
        </div>
        <div>
            <p>Top Project</p>
            <p><%= period.projects[0]?.name ?? "none" %></p>
        </div>
        <div>
            <p>Top Language</p>
            <p><%= period.languages[0]?.name ?? "none" %></p>
        </div>
        <div>
            <p>Top OS</p>
            <p><%= period.oses[0]?.name ?? "none" %></p>
        </div>
        <div>
            <p>Top Editor</p>
            <p><%= period.editors[0]?.name ?? "none" %></p>
        </div>
        <div>
            <p>Top Category</p>
            <p><%= period.categories[0]?.name ?? "none" %></p>
        </div>
    </div>






    <% if (goals) { %>
        <div class="goals">
            <% goals.forEach(goal => { %>
                <div>
                    <div>
                        <p><span><%= goal.today %></span>/<% goal.target %></p>
                        <p>All programming activity</p>
                    </div>
                    <div>
                        <div>
                            <p>Daily goal</p>
                            <p><% goal.todayLeft %> left today</p>
                        </div>
                    </div>
                </div>
                <div>
                    <p>50%</p>
                    <div>bar</div>
                </div>
            <% }) %>
        </div>
    <% } %>






    <div class="graphs">
        <div class="graph-card">
            <p>Project Durations</p>
            <div class="chart-wrap durations">
                <% if (!durations.length) { %>
                    <p>No activity yet...</p>
                <% } %>

                <% durations.forEach(duration => { %>
                    <div class="duration-row">
                        <p class="duration-name"><%= duration.name %></p>
                        <div class="duration-track">
                            <div class="duration-bar" style="width: <%= duration.width %>%">
                                <%= duration.text %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
        <div class="graph-card">
            <p>Languages</p>
            <div class="chart-wrap">
                <canvas id="languages"></canvas>
            </div>
        </div>
        <div class="graph-card">
            <p>Editors</p>
            <div class="chart-wrap">
                <canvas id="editors"></canvas>
            </div>
        </div>
        <div class="graph-card">
            <p>OSes</p>
            <div class="chart-wrap">
                <canvas id="oses"></canvas>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const charts = <%- JSON.stringify(charts) %>

    function pie(id, rows) {
        const el = document.getElementById(id)
        if (!el) return

        new Chart(el, {
            type: "pie",
            data: {
                labels: rows.map(r => r.label),
                datasets: [{ 
                    data: rows.map(r => r.value),
                    borderWidth: 0,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: "bottom" }}
            }
        })
    }

    pie("languages", charts.languages)
    pie("editors", charts.editors)
    pie("oses", charts.oses)
</script>