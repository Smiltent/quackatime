
<div class="dashboard">

    <%- include("components/$header") %>

    <div class="filters" id="filters" data-query="<%= JSON.stringify(queryBase) %>">
        <div class="filter" data-key="range">
            <button class="filter-trigger" aria-expanded="false">
                <span class="filter-label">Date Range</span>
                <span class="filter-value"><%= filters.label %></span>
            </button> 
            <div class="filter-menu" hidden>
                <% filters.presets.forEach(p => { %>
                    <button 
                        class="filter-option <%= filters.range === p ? 'is-active' : '' %>" 
                        data-range="<%= p %>"
                    ><%= filters.labels[p] %></button>
                <% }) %>
                <button
                    type="button"
                    class="filter-option filter-custom-toggle <%= filters.range === 'custom' ? 'is-active' : '' %>"
                    aria-expanded="<%= filters.range === 'custom' ? 'true' : 'false' %>"
                >Custom</button>
                <div class="filter-custom <%= filters.range === 'custom' ? 'is-open' : '' %>">
                    <label>
                        <span>From</span>
                        <input type="date" class="filter-from" value="<%= filters.range === 'custom' ? filters.from : '' %>">
                    </label>
                    <label>
                        <span>To</span>
                        <input type="date" class="filter-to" value="<%= filters.range === 'custom' ? filters.to : '' %>">
                    </label>
                    <button type="button" class="filter-apply-custom">Apply</button>
                </div>
            </div>
        </div>

        <%
            const facetFilters = [
                { key: 'project', label: 'Project', options: filterOptions.projects, value: filters.project },
                { key: 'language', label: 'Language', options: filterOptions.languages, value: filters.language },
                { key: 'os', label: 'OS', options: filterOptions.oses, value: filters.os },
                { key: 'editor', label: 'Editor', options: filterOptions.editors, value: filters.editor },
                { key: 'category', label: 'Category', options: filterOptions.categories, value: filters.category },
            ]
        %>

        <% facetFilters.forEach(f => { %>
            <div class="filter" data-key="<%= f.key %>">
                <button class="filter-trigger" aria-expanded="false">
                    <span class="filter-label"><%= f.label %></span>
                    <span class="filter-value"><%= f.value || "All" %></span>
                </button>
                <div class="filter-menu" hidden>
                    <button class="filter-option <%= !f.value ? 'is-active' : '' %>" data-value="">All</button>

                    <% f.options.forEach(opt => { %>
                        <button class="filter-option <%= f.value === opt ? 'is-active' : '' %>" data-value="<%= opt %>"><%= opt %></button>
                    <% }) %>
                </div>
            </div>
        <% }) %>

    </div>





    <% if (goals) { %>
        <div class="goals" style="--goal-cols: <%= Math.min(goals.length, 3) %>">
            <% goals.forEach(goal => { %>
                <div class="goal <%= goal.done ? 'is-done' : '' %>">
                    <div class="goal-main">
                        <div class="goal-stats">
                            <p>
                                <span><%= goal.progressText %></span>/<%= goal.targetText %>
                            </p>
                            <p class="goal-scope"><%= goal.scope %></p>
                        </div>
                        <div class="goal-meta">
                            <p class="goal-period"><%= goal.periodLabel %></p>
                            <p class="goal-left">
                                <% if (goal.done) { %>
                                    Done
                                <% } else { %>
                                    <%= goal.leftText %> left
                                <% } %>
                            </p>
                        </div>
                    </div>
                    <div class="goal-progress">
                        <div class="goal-track">
                            <div class="goal-bar" style="width: <%= goal.percent %>%"></div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>





    <div class="quickInfo">
        <div>
            <p>Total Time</p>
            <p><%= period.text %></p>
        </div>
        <div>
            <p>Top Project</p>
            <p><%= period.projects[0]?.name ?? "none" %></p>
        </div>
        <div>
            <p>Top Language</p>
            <p><%= period.languages[0]?.name ?? "none" %></p>
        </div>
        <div>
            <p>Top OS</p>
            <p><%= period.oses[0]?.name ?? "none" %></p>
        </div>
        <div>
            <p>Top Editor</p>
            <p><%= period.editors[0]?.name ?? "none" %></p>
        </div>
        <div>
            <p>Top Category</p>
            <p><%= period.categories[0]?.name ?? "none" %></p>
        </div>
    </div>






    <div class="graphs">
        <div class="graph-card">
            <p>Project Durations</p>
            <div class="chart-wrap durations">
                <% durations.forEach(duration => { %>
                    <div class="duration-row">
                        <p class="duration-name"><%= duration.name %></p>
                        <div class="duration-track">
                            <div class="duration-bar" style="width: <%= duration.width %>%">
                                <%= duration.text %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
        <div class="graph-card">
            <p>Languages</p>
            <div class="chart-wrap">
                <canvas id="languages"></canvas>
            </div>
        </div>
        <div class="graph-card">
            <p>Editors</p>
            <div class="chart-wrap">
                <canvas id="editors"></canvas>
            </div>
        </div>
        <div class="graph-card">
            <p>OSes</p>
            <div class="chart-wrap">
                <canvas id="oses"></canvas>
            </div>
        </div>
    </div>
</div>





<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const charts = <%- JSON.stringify(charts) %>

    function pie(id, rows) {
        const el = document.getElementById(id)
        if (!el) return

        new Chart(el, {
            type: "pie",
            data: {
                labels: rows.map(r => r.label),
                datasets: [{ 
                    data: rows.map(r => r.value),
                    borderWidth: 0,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: "bottom" }}
            }
        })
    }

    pie("languages", charts.languages)
    pie("editors", charts.editors)
    pie("oses", charts.oses)
</script>




<script>
    (function () {
        const root = document.getElementById("filters")
        if (!root) return

        const base = JSON.parse(root.dataset.query || "{}")
        function go(patch) {
            const next = { ...base, ...patch }
            const sp = new URLSearchParams()

            for (const [k, v] of Object.entries(next)) {
                if (v != null && v !== "") {
                    sp.set(k, String(v))
                }

                if (next.range !== "custom") {
                    sp.delete("from")
                    sp.delete("to")
                }

                location.href = "/?" + sp.toString()
            }
        }

        function closeAll(except) {
            root.querySelectorAll(".filter").forEach(f => {
                if (f === except) return
                f.classList.remove("is-open")

                const menu = f.querySelector(".filter-menu")
                const btn = f.querySelector(".filter-trigger")

                if (menu) {
                    menu.hidden = true
                }
                if (btn) {
                    btn.setAttribute("aria-expanded", "false")
                }
            })
        }

        root.querySelectorAll(".filter").forEach(filter => {
            const key = filter.dataset.key
            const trigger = filter.querySelector(".filter-trigger")
            const menu = filter.querySelector(".filter-menu")
            if (!trigger || !menu) return

            trigger.addEventListener("click", (e) => {
                e.stopPropagation()
                const open = filter.classList.contains("is-open")

                closeAll()
                if (!open) {
                    filter.classList.add("is-open")
                    menu.hidden = false
                    trigger.setAttribute("aria-expanded", "true")
                }
            })

            menu.addEventListener("click", (e) => e.stopPropagation())

            if (key === "range") {
                menu.querySelectorAll("[data-range]").forEach(btn => {
                    btn.addEventListener("click", () => {
                        go({ range: btn.getAttribute("data-range"), from: undefined, to: undefined })
                    })
                })

                const customPanel = menu.querySelector(".filter-custom")
                const customToggle = menu.querySelector(".filter-custom-toggle")
                const fromInput = menu.querySelector(".filter-from")
                const toInput = menu.querySelector(".filter-to")
                const apply = menu.querySelector(".filter-apply-custom")

                function syncApply() {
                    if (!apply) return
                    apply.disabled = !(fromInput?.value && toInput?.value)
                }

                customToggle?.addEventListener("click", () => {
                    const open = customPanel?.classList.toggle("is-open")
                    customToggle.classList.toggle("is-active", !!open)
                    customToggle.setAttribute("aria-expanded", open ? "true" : "false")
                    if (open) fromInput?.focus()
                })

                fromInput?.addEventListener("input", syncApply)
                toInput?.addEventListener("input", syncApply)
                syncApply()

                apply?.addEventListener("click", () => {
                    const from = fromInput?.value
                    const to = toInput?.value
                    if (!from || !to) return

                    go({ range: "custom", from, to })
                })
            } else {
                menu.querySelectorAll(".filter-option").forEach(btn => {
                    btn.addEventListener("click", () => {
                        go({ [key]: btn.getAttribute("data-value") || undefined })
                    })
                })
            }
        })

        document.addEventListener("click", () => closeAll())
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                closeAll()
            }
        })
    })()
</script>