
<div class="dashboard">
    <%- include("../components/$header") %>

    <%- include("../components/settings/$nav") %>

    <%- include("../components/settings/$banner") %>

    <div class="settings-real">
        <section class="settings-sec">
            <h2>Tracking setup</h2>
            <ol class="settings-steps">
                <li>Install any WakaTime plugin for your editor</li>
                <li>Paste the configuration in your WakaTime config file, usually located here: <code>~/.wakatime.cfg</code></li>
                <li>Code as usual. Now, heartbeats will show up on the dashboard</li>
            </ol>
            <div class="settings-kv">
                <% if (revealedKey) { %>
                    <h2>Config</h2>
                    <code id="apiKey"># put this in your ~/.wakatime.cfg file

[settings]
api_url = <%= apiBase %>/api/v1
api_key = <%= revealedKey %>
heartbeat_rate_limit_seconds = 30</code>
                <% } else if (hasApiKey) { %>
                    <h2>Config</h2>
                    <code id="is-masked"># put this in your ~/.wakatime.cfg file

[settings]
api_url = <%= apiBase %>/api/v1
api_key = ************************************
heartbeat_rate_limit_seconds = 30</code>
                <% } else { %>
                    <p class="settings-muted">No API key yet. Generate one below</p>
                <% } %>
            </div>
            <form action="/api/v1/settings/apiKey" method="POST">
                <button type="submit">
                    <%= hasApiKey ? "Regenerate API key" : "Generate API key" %>
                </button>
            </form>
            <% if (hasApiKey) { %>
                <p class="settings-muted">Regenerating invalidated your previous key!</p>
            <% } %>
        </section>
    </div>
</div>