
<div class="flex-col auth">
    <div>
        <img src="/public/assets/logo.png" alt="Logo">
    </div>

    <form class="flex-col" action="/auth/login" method="POST">
        <input type="text" name="login" placeholder="username or email" autocomplete="off">
        <input type="password" name="password" placeholder="password">
        
        <input type="submit" value="Login">
    </form>

    <p class="createAccount">
        New here? <a id="createLink" href="/register">Create an account</a>.
    </p>
</div>

