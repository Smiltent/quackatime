
<div class="auth">
    <div>
        <img src="/public/assets/logo.svg" alt="Logo">
    </div>

    <form action="/auth/login" method="POST">
        <input type="text" name="login" required="true" placeholder="username or email" autocomplete="off" value="<%= locals.login || '' %>">
        <input type="password" name="password" required="true" placeholder="password">
        
        <% if (locals.error) { %>
            <p class="error"><%= locals.error %></p>
        <% } %>

        <input type="submit" value="Login">
    </form>

    <p class="authFooter">
        New here? <a id="link" href="/register">Create an account</a>.
    </p>
</div>

